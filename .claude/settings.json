{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(pytest *)",
      "Bash(python3 *)",
      "Bash(source venv/bin/activate *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(systemctl restart k8s-netlab)",
      "Bash(systemctl status k8s-netlab)",
      "Bash(journalctl -u k8s-netlab *)",
      "Bash(curl *)",
      "Bash(pvesh *)",
      "Bash(bash scripts/*)",
      "Bash(cat data/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash(systemctl restart k8s-netlab)",
        "hooks": [
          {
            "type": "command",
            "command": "sleep 3 && curl -s https://lab.cloudnetops.tech/api/health | python3 -m json.tool; journalctl -u k8s-netlab -p err --since '2 minutes ago' --no-pager | head -20"
          }
        ]
      }
    ]
  }
}
