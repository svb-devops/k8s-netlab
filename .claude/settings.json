{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(pytest *)",
      "Bash(python3 *)",
      "Bash(source venv/bin/activate *)",
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(systemctl restart k8s-netlab)",
      "Bash(systemctl status k8s-netlab)",
      "Bash(journalctl -u k8s-netlab *)",
      "Bash(curl *)",
      "Bash(pvesh *)",
      "Bash(bash scripts/*)",
      "Bash(cat data/*)",
      "Bash(export KUBECONFIG=/etc/labgen/home_lab_mvp.kubeconfig)",
      "Bash(kubectl get *)",
      "Bash(awk '$1 !~ /^kube-system|^kube-public|^kube-node-lease/')"
    ],
    "deny": [
      "Bash(qm destroy*)",
      "Bash(qm delete*)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(rm -rf /*)",
      "Bash(DROP TABLE*)",
      "Bash(DROP DATABASE*)"
    ]
  }
}
