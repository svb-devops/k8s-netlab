# LabGen MVP — Staging Environment Template
# ============================================================
# STAGING-ONLY template. NOT for production deployment.
# Derived from .env.production.example with staging-safe defaults.
#
# Use this file to populate staging env variables.
# Copy to .env (gitignored) and fill in all <set-in-staging-secret-manager>
# values via your secret manager / CI/CD secret injection.
#
# NEVER commit real secrets to git.
# This file must contain ONLY placeholder values.
#
# Legend:
#   [REQUIRED]       Must be set before starting the service.
#   [SECRET]         Inject via secret manager — never in plaintext on disk.
#   [STAGING-NOTE]   Behaviour differs from production in staging context.
#   [DISABLED]       Must remain at this value for staging dry run.
# ============================================================
#
# Staging dry run expectations:
#   - Service starts and diagnostics work.
#   - Lab sessions CANNOT be created: K3sNamespaceLifecycleAdapter is NotImplementedError.
#     This is expected and correct (production safety guard is active).
#   - No real K3s, no real Proxmox, no real LLM during dry run.
#   - Preflight will PASS with warnings for placeholder credential root.
# ============================================================


# ------------------------------------------------------------
# A. Runtime and Namespace Adapter
# ------------------------------------------------------------

# [REQUIRED] Controls safety checks and adapter requirements.
# production mode: stub adapter causes every lab start to fail (expected in staging).
LABGEN_RUNTIME_MODE=production

# [REQUIRED] Which namespace lifecycle adapter to use.
# k8s is the production-safe value. With production mode + k8s adapter:
#   - Preflight PASSES.
#   - Lab starts FAIL with NotImplementedError (K3sNamespaceLifecycleAdapter skeleton).
#   This is the expected fail-closed staging behaviour.
LABGEN_NAMESPACE_ADAPTER=k8s

# [REQUIRED if LABGEN_NAMESPACE_ADAPTER=k8s]
# Absolute path to the platform kubeconfig for namespace lifecycle management.
# In staging dry run this file does not need to exist (lab starts fail before reading it).
# [SECRET] Inject via secret manager for real staging integration.
# LABGEN_K8S_PLATFORM_KUBECONFIG_PATH=<set-in-staging-secret-manager>


# ------------------------------------------------------------
# B. Verifier Credentials
# ------------------------------------------------------------

# [REQUIRED] Root directory for per-VM verifier credential files.
# Staging: use a staging-specific path isolated from any other environment.
# Must be an absolute path. Permissions: chmod 700.
LABGEN_VERIFIER_CREDENTIAL_ROOT=/var/lib/labgen-staging/verifier-credentials


# ------------------------------------------------------------
# C. LLM Provider
# ------------------------------------------------------------

# [DISABLED] LLM provider mode — must remain fake_only for staging dry run.
# Changing to live_enabled requires explicit approval + real API key injection.
LABGEN_LLM_PROVIDER_MODE=fake_only

# LLM provider name — only used when LABGEN_LLM_PROVIDER_MODE=live_enabled.
LABGEN_LLM_PROVIDER_NAME=fake

# LLM call timeout in milliseconds.
LABGEN_LLM_TIMEOUT_MS=30000

# Maximum output tokens per LLM call.
LABGEN_LLM_MAX_OUTPUT_TOKENS=4096

# Leave these empty — LLM live mode is disabled.
LABGEN_LLM_OPENAI_BASE_URL=
LABGEN_LLM_OPENAI_MODEL=

# [SECRET] OpenAI-compatible API key.
# Leave unset in staging dry run (LABGEN_LLM_PROVIDER_MODE=fake_only).
# LABGEN_LLM_OPENAI_API_KEY=<set-in-staging-secret-manager>


# ------------------------------------------------------------
# D. Lab Session / Expiry
# ------------------------------------------------------------

# Lab session TTL in minutes. Must be >= 1.
# Staging: 30 minutes is suitable for dry run.
LABGEN_LAB_SESSION_TTL_MINUTES=30


# ------------------------------------------------------------
# E. Proxmox / VM
# ------------------------------------------------------------

# [REQUIRED] Proxmox API hostname (staging Proxmox instance).
# [STAGING-NOTE] Use staging Proxmox host, not production.
PROXMOX_HOST=<staging-host>

# Proxmox API port.
PROXMOX_PORT=8006

# Proxmox node name.
PROXMOX_NODE=pve

# [REQUIRED] Proxmox token auth.
# [STAGING-NOTE] Use a staging-specific token with limited permissions.
PROXMOX_TOKEN_ID=labgen-staging@pve!labgen-staging-api

# [SECRET] Proxmox API token secret.
# PROXMOX_TOKEN_SECRET=<set-in-staging-secret-manager>

# [SECRET] VM SSH password.
# VM_SSH_PASSWORD=<set-in-staging-secret-manager>

# VM template ID. Must be in the k8s-netlab pool.
VM_TEMPLATE_ID=101

# VM VCPU and memory configuration.
VM_CORES=2
VM_MEMORY_MB=4096

# VM auto-assignment ID range. Must not overlap VM_TEMPLATE_ID.
VM_ID_MIN=500
VM_ID_MAX=599

# Proxmox pool for permission scoping.
PROXMOX_POOL=k8s-netlab

# Registry mirror URL.
VM_REGISTRY_MIRROR=http://<staging-host>:5000

# VM SSH user.
VM_SSH_USER=root

# Network configuration for student VMs.
VM_NETWORK=<staging-vm-subnet-cidr>
VM_GATEWAY=<staging-host>
VM_BRIDGE=vmbr1


# ------------------------------------------------------------
# F. Auth / Admin
# ------------------------------------------------------------

# [SECRET] Static admin token (X-Admin-Token header). >= 32 characters.
# Must be injected via secret manager before starting the service.
# Without this, admin diagnostics endpoints return 503.
# ADMIN_TOKEN=<set-in-staging-secret-manager>

# Comma-separated list of admin usernames.
ADMIN_USERNAMES=admin

# [STAGING-NOTE] Set to false if staging does not use HTTPS.
# false causes a preflight WARNING (acceptable in staging without TLS).
# Set to true if staging is behind a TLS-terminating reverse proxy.
SESSION_COOKIE_SECURE=false


# ------------------------------------------------------------
# G. CORS / Frontend
# ------------------------------------------------------------

# Allowed origins for CORS. Staging: restrict to staging host only.
ALLOWED_ORIGINS=http://<staging-host>:8000


# ------------------------------------------------------------
# H. Application Server
# ------------------------------------------------------------

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
# [STAGING-NOTE] text format is easier to read in staging logs.
# Use json in production for structured log ingestion.
LOG_FORMAT=text


# ------------------------------------------------------------
# I. Quota
# ------------------------------------------------------------

# Staging: small quotas to prevent accidental VM sprawl.
MAX_VMS_PER_USER=1
MAX_TOTAL_VMS=4


# ------------------------------------------------------------
# J. Optional Integrations (leave empty to disable)
# ------------------------------------------------------------

# Directus CMS — leave empty to disable.
# DIRECTUS_URL=http://127.0.0.1:8055

# DeepSeek AI tutor — leave empty to disable.
# DEEPSEEK_API_KEY=<set-in-staging-secret-manager>
# DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------
# NOT INCLUDED — values that must NOT appear here:
# - Real API keys or tokens
# - Real Proxmox credentials
# - Real kubeconfig content
# - Real private keys or certificates
# - Production secrets of any kind
# All secrets must be injected via secret manager at runtime.
# ------------------------------------------------------------
