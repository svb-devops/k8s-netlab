# LabGen MVP — Staging Environment Template (home_lab_mvp profile)
# ============================================================
# STAGING-ONLY template. NOT for production deployment.
# Profile: home_lab_mvp (T430 same-Proxmox staging with explicit isolation)
#
# Use this file to populate staging env variables.
# Copy to .env.staging (gitignored) and fill in all <set-in-staging-secret-manager>
# values via your secret manager / CI/CD secret injection.
#
# NEVER commit real secrets to git.
# This file must contain ONLY placeholder values.
#
# Legend:
#   [REQUIRED]       Must be set before starting the service.
#   [SECRET]         Inject via secret manager — never in plaintext on disk.
#   [STAGING-NOTE]   Behaviour differs from production in staging context.
#   [DISABLED]       Must remain at this value for staging dry run.
#   [PLACEHOLDER]    This value is a placeholder — placeholder detection will BLOCK, not pass.
# ============================================================
#
# Staging expectations (home_lab_mvp profile):
#   - Service starts and diagnostics work.
#   - Lab sessions require real kubeconfig (OPS-K3S-001) to start.
#   - Stub adapter is BLOCKED in home_lab_mvp — fail-closed by design.
#   - No real K3s, no real Proxmox, no real LLM until ops injects real secrets.
#   - Preflight will PASS when all required secrets are set.
#
# Same-Proxmox isolation requirements (see HOME_LAB_MVP_STAGING_PROFILE_v0.1.md):
#   - Staging pool: k8s-netlab-staging (NOT k8s-netlab)
#   - Staging VMID range: must NOT overlap 500–599 (production range)
#   - Staging template: NOT VM 101 (production template)
#   - Staging admin token: separate from production ADMIN_TOKEN
#   - Staging verifier credential root: /var/lib/labgen-staging/verifier-credentials
#   - Staging service port: 8001 (separate from production 8000)
# ============================================================


# ------------------------------------------------------------
# A. Runtime and Namespace Adapter
# ------------------------------------------------------------

# [REQUIRED] Controls safety checks and adapter requirements.
# home_lab_mvp mode: stub adapter is a hard blocking error at lab start.
# home_lab_mvp is the correct profile for T430 staging — not 'production'.
LABGEN_RUNTIME_MODE=home_lab_mvp

# [REQUIRED] Which namespace lifecycle adapter to use.
# k8s is required in home_lab_mvp mode. stub → every lab start fails (expected fail-closed).
LABGEN_NAMESPACE_ADAPTER=k8s

# [REQUIRED] Absolute path to the platform kubeconfig for namespace lifecycle management.
# Distinct from per-VM verifier kubeconfigs (those are managed by VerifierIdentityManager).
# OPS-K3S-001 is responsible for provisioning this kubeconfig.
# [SECRET] Inject via secret manager.
# LABGEN_K8S_PLATFORM_KUBECONFIG_PATH=<set-in-staging-secret-manager>

# [REQUIRED] Use in-cluster config — must be false for home_lab_mvp (not running inside K8s).
LABGEN_K8S_IN_CLUSTER=false

# Optional kubeconfig context to use. Leave empty to use default context from kubeconfig.
LABGEN_K8S_CONTEXT=

# K8s API call timeout in seconds (default 10).
LABGEN_K8S_API_TIMEOUT_SECONDS=10

# Comma-separated namespace prefix whitelist.
# [STAGING-NOTE] Use staging-specific prefix to prevent collision with production namespaces
# if staging and production share the same K3s cluster.
# If separate K3s cluster: use lab- (same as production on that cluster).
LABGEN_K8S_NAMESPACE_ALLOWED_PREFIXES=lab-stg-

# Verifier ServiceAccount name (default: labgen-verifier).
LABGEN_K8S_VERIFIER_SA_NAME=labgen-verifier

# Namespace where the verifier ServiceAccount lives (default: kube-system).
LABGEN_K8S_VERIFIER_SA_NAMESPACE=kube-system

# ClusterRole name granting read-only verifier access (default: labgen-verifier-role).
LABGEN_K8S_VERIFIER_ROLE_NAME=labgen-verifier-role

# RoleBinding name created per lab namespace (default: labgen-verifier-binding).
LABGEN_K8S_VERIFIER_ROLEBINDING_NAME=labgen-verifier-binding


# ------------------------------------------------------------
# B. Verifier Credentials
# ------------------------------------------------------------

# [REQUIRED] Root directory for per-VM verifier credential files.
# [STAGING-NOTE] Must use staging-specific path — isolated from production.
# Must be an absolute path. Permissions: chmod 700.
LABGEN_VERIFIER_CREDENTIAL_ROOT=/var/lib/labgen-staging/verifier-credentials


# ------------------------------------------------------------
# C. LLM Provider
# ------------------------------------------------------------

# [DISABLED] LLM provider mode — must remain fake_only for staging.
# Changing to live_enabled requires explicit approval + real API key injection.
LABGEN_LLM_PROVIDER_MODE=fake_only

# LLM provider name — only used when LABGEN_LLM_PROVIDER_MODE=live_enabled.
LABGEN_LLM_PROVIDER_NAME=fake

# LLM call timeout in milliseconds.
LABGEN_LLM_TIMEOUT_MS=30000

# Maximum output tokens per LLM call.
LABGEN_LLM_MAX_OUTPUT_TOKENS=4096

# Leave these empty — LLM live mode is disabled.
LABGEN_LLM_OPENAI_BASE_URL=
LABGEN_LLM_OPENAI_MODEL=

# [SECRET] OpenAI-compatible API key.
# Leave unset in staging (LABGEN_LLM_PROVIDER_MODE=fake_only).
# LABGEN_LLM_OPENAI_API_KEY=<set-in-staging-secret-manager>


# ------------------------------------------------------------
# D. Lab Session / Expiry
# ------------------------------------------------------------

# Lab session TTL in minutes. Must be >= 1.
# [STAGING-NOTE] 30 minutes is suitable for staging pilot.
LABGEN_LAB_SESSION_TTL_MINUTES=30


# ------------------------------------------------------------
# E. Proxmox / VM (staging-isolated values)
# ------------------------------------------------------------

# [REQUIRED] Proxmox API hostname.
# [STAGING-NOTE] May be the same physical host as production IF staging pool is isolated.
# See HOME_LAB_MVP_STAGING_PROFILE_v0.1.md Section C for isolation requirements.
# [PLACEHOLDER] Replace with real staging Proxmox host.
PROXMOX_HOST=<staging-proxmox-host>

# Proxmox API port.
PROXMOX_PORT=8006

# Proxmox node name.
PROXMOX_NODE=pve

# [REQUIRED] Proxmox token auth.
# [STAGING-NOTE] Must use staging-specific token — NOT the production labgen@pve!labgen-api token.
PROXMOX_TOKEN_ID=labgen-staging@pve!labgen-staging-api

# [SECRET] Proxmox API token secret (staging token).
# PROXMOX_TOKEN_SECRET=<set-in-staging-secret-manager>

# [SECRET] VM SSH password.
# VM_SSH_PASSWORD=<set-in-staging-secret-manager>

# VM template ID.
# [STAGING-NOTE] Must NOT be 101 (production template). Staging requires a dedicated template.
# Allocate a staging template VM in the staging VMID range.
VM_TEMPLATE_ID=<staging-template-vmid>

# VM VCPU and memory configuration.
VM_CORES=2
VM_MEMORY_MB=4096

# VM auto-assignment ID range.
# [STAGING-NOTE] Must NOT overlap the production range 500–599.
# Example staging ranges: 550–579 (if production is narrowed to 500–549) or a different range.
# Coordinate with Proxmox infrastructure owner before setting.
VM_ID_MIN=<staging-vm-id-min>
VM_ID_MAX=<staging-vm-id-max>

# Proxmox pool for permission scoping.
# [STAGING-NOTE] Must be a dedicated staging pool — NOT k8s-netlab (production pool).
# Create with: pvesh create /pools --poolid k8s-netlab-staging
PROXMOX_POOL=k8s-netlab-staging

# Registry mirror URL.
# [STAGING-NOTE] Must be isolated from production registry.
# Option A: Same host, different port (e.g. 5002).
# Option B: Path prefix isolation on same registry.
VM_REGISTRY_MIRROR=http://<staging-host>:<staging-registry-port>

# VM SSH user.
VM_SSH_USER=root

# Network configuration for student VMs.
# [STAGING-NOTE] Same bridge as production (vmbr1) is acceptable at MVP — ACCEPTED_MVP_RISK.
# See HOME_LAB_MVP_STAGING_PROFILE_v0.1.md Section C (RISK-08).
VM_NETWORK=<staging-vm-subnet-cidr>
VM_GATEWAY=<staging-host>
VM_BRIDGE=vmbr1


# ------------------------------------------------------------
# F. Auth / Admin
# ------------------------------------------------------------

# [SECRET] Static admin token (X-Admin-Token header). >= 32 characters.
# [STAGING-NOTE] Must be a DIFFERENT token from production ADMIN_TOKEN.
# Without this, admin diagnostics endpoints return 503.
# ADMIN_TOKEN=<set-in-staging-secret-manager>

# Comma-separated list of admin usernames.
ADMIN_USERNAMES=admin

# [STAGING-NOTE] Set to false if staging does not use HTTPS.
# false causes a preflight WARNING (acceptable in staging without TLS).
SESSION_COOKIE_SECURE=false


# ------------------------------------------------------------
# G. CORS / Frontend
# ------------------------------------------------------------

# Allowed origins for CORS. Staging: restrict to staging host only.
ALLOWED_ORIGINS=http://<staging-host>:8001


# ------------------------------------------------------------
# H. Application Server
# ------------------------------------------------------------

APP_HOST=0.0.0.0
# [STAGING-NOTE] Use port 8001 to avoid collision with production on port 8000.
APP_PORT=8001
APP_DEBUG=false
LOG_LEVEL=INFO
# [STAGING-NOTE] text format is easier to read in staging logs.
LOG_FORMAT=text


# ------------------------------------------------------------
# I. Quota (staging — strict limits to prevent VM sprawl on T430)
# ------------------------------------------------------------

# Maximum VMs per student user.
MAX_VMS_PER_USER=1

# Maximum total VMs system-wide.
# [STAGING-NOTE] Hard cap: T430 supports ~3 concurrent K3s VMs before CPU bottleneck.
# See HOME_LAB_MVP_STAGING_PROFILE_v0.1.md Section D.
MAX_TOTAL_VMS=3


# ------------------------------------------------------------
# J. Optional Integrations (leave empty to disable)
# ------------------------------------------------------------

# Directus CMS — leave empty to disable.
# DIRECTUS_URL=http://127.0.0.1:8055

# DeepSeek AI tutor — leave empty to disable.
# DEEPSEEK_API_KEY=<set-in-staging-secret-manager>
# DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------
# NOT INCLUDED — values that must NOT appear here:
# - Real API keys or tokens
# - Real Proxmox credentials
# - Real kubeconfig content
# - Real private keys or certificates
# - Production secrets of any kind
# All secrets must be injected via secret manager at runtime.
# ------------------------------------------------------------
