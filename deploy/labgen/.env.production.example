# LabGen MVP — Production Environment Template
# ============================================================
# This file is a TEMPLATE only. It contains placeholder values.
# NEVER commit real secrets to git.
# Copy to .env (gitignored) and fill in all <set-in-secret-manager> values
# via your secret manager / CI/CD secret injection.
#
# Legend:
#   [REQUIRED]   Must be set before starting the service.
#   [SECRET]     Inject via secret manager — never in plaintext on disk.
#   [DISABLED]   Must remain at this value for initial production deploy.
#   [DEV-ONLY]   Must NOT be set to the dev default in production.
# ============================================================


# ------------------------------------------------------------
# A. Runtime and Namespace Adapter
# ------------------------------------------------------------

# [REQUIRED] Controls safety checks and adapter requirements.
# Values: test | dev | demo | production
# Production: stub adapter is a hard blocking error at lab start.
LABGEN_RUNTIME_MODE=production

# [REQUIRED] Which namespace lifecycle adapter to use.
# Values: stub | k8s
# production mode requires k8s. stub in production → every lab start fails.
# NOTE: K3sNamespaceLifecycleAdapter is currently a skeleton (NotImplementedError).
#       Set to k8s only after the adapter is implemented.
#       Until then, leave LABGEN_RUNTIME_MODE=demo or accept that lab starts are blocked.
LABGEN_NAMESPACE_ADAPTER=k8s

# [REQUIRED if LABGEN_NAMESPACE_ADAPTER=k8s]
# Absolute path to the platform kubeconfig for namespace lifecycle management.
# Distinct from per-VM verifier kubeconfigs (those are managed by VerifierIdentityManager).
# Restricted permissions: chmod 600, owned by service user.
LABGEN_K8S_PLATFORM_KUBECONFIG_PATH=/etc/labgen/platform-kubeconfig.yaml


# ------------------------------------------------------------
# B. Verifier Credentials
# ------------------------------------------------------------

# [REQUIRED] Root directory for per-VM verifier credential files.
# Must be an absolute path outside the application directory.
# Permissions: chmod 700, owned by service user.
# Default creds/vm_creds is relative to CWD — unsafe for production.
LABGEN_VERIFIER_CREDENTIAL_ROOT=/var/lib/labgen/verifier-credentials


# ------------------------------------------------------------
# C. LLM Provider
# ------------------------------------------------------------

# [DISABLED] LLM provider mode at initial production deploy.
# Values: disabled | fake_only | dry_run | live_disabled | live_enabled
# Must be fake_only or disabled for initial deploy.
# Changing to live_enabled requires explicit approval + secret injection.
LABGEN_LLM_PROVIDER_MODE=fake_only

# LLM provider name — only meaningful when LABGEN_LLM_PROVIDER_MODE=live_enabled.
# Values: fake | openai | anthropic | gemini | custom | openai_compatible
LABGEN_LLM_PROVIDER_NAME=fake

# LLM call timeout in milliseconds (max 60000).
LABGEN_LLM_TIMEOUT_MS=30000

# Maximum output tokens per LLM call (max 8192).
LABGEN_LLM_MAX_OUTPUT_TOKENS=4096

# OpenAI-compatible base URL — only used when LABGEN_LLM_PROVIDER_MODE=live_enabled
# and LABGEN_LLM_PROVIDER_NAME=openai_compatible.
# Leave empty unless live generation is explicitly enabled.
LABGEN_LLM_OPENAI_BASE_URL=

# OpenAI-compatible model name — only used with live_enabled + openai_compatible.
LABGEN_LLM_OPENAI_MODEL=

# [SECRET] OpenAI-compatible API key.
# MUST be injected via secret manager at runtime — never store in this file.
# Leave unset if LABGEN_LLM_PROVIDER_MODE != live_enabled.
# LABGEN_LLM_OPENAI_API_KEY=<set-in-secret-manager>


# ------------------------------------------------------------
# D. Lab Session / Expiry
# ------------------------------------------------------------

# Lab session TTL in minutes. Sessions active beyond this are eligible for expiry.
# Must be >= 1. Adjust per curriculum (e.g. 45 for a 45-minute lab slot).
LABGEN_LAB_SESSION_TTL_MINUTES=30


# ------------------------------------------------------------
# E. Proxmox / VM
# ------------------------------------------------------------

# [REQUIRED] Proxmox API hostname or IP.
PROXMOX_HOST=<proxmox-host>

# Proxmox API port (default 8006).
PROXMOX_PORT=8006

# Proxmox node name (default pve).
PROXMOX_NODE=pve

# [REQUIRED] Proxmox token auth (recommended over password auth).
# Format: user@realm!tokenname
PROXMOX_TOKEN_ID=labgen@pve!labgen-api

# [SECRET] Proxmox API token secret.
# PROXMOX_TOKEN_SECRET=<set-in-secret-manager>

# [SECRET] VM SSH password (used by the backend to SSH into student VMs).
# VM_SSH_PASSWORD=<set-in-secret-manager>

# VM template ID. Must be in the k8s-netlab pool.
VM_TEMPLATE_ID=101

# VM VCPU and memory configuration.
VM_CORES=2
VM_MEMORY_MB=4096

# VM auto-assignment ID range (must not overlap VM_TEMPLATE_ID).
VM_ID_MIN=500
VM_ID_MAX=599

# Proxmox pool for permission scoping.
PROXMOX_POOL=k8s-netlab

# Registry mirror URL (pull-through cache for docker.io images).
# Defaults to http://<VM_GATEWAY>:5000; set to an HTTPS endpoint in production.
VM_REGISTRY_MIRROR=http://<PROXMOX_HOST_IP>:5000

# VM SSH user (default root).
VM_SSH_USER=root

# Network configuration for student VMs.
VM_NETWORK=<VM_SUBNET_CIDR>
VM_GATEWAY=<PROXMOX_HOST_IP>
VM_BRIDGE=vmbr1


# ------------------------------------------------------------
# F. Auth / Admin
# ------------------------------------------------------------

# [SECRET] Static admin token for admin API endpoints (X-Admin-Token header).
# Must be >= 32 characters. Inject via secret manager.
# ADMIN_TOKEN=<set-in-secret-manager>

# Comma-separated list of usernames with admin privileges.
# Keep this list small and known. Demo seed endpoint is accessible to these users.
ADMIN_USERNAMES=admin

# Session cookie secure flag — must be true behind HTTPS.
SESSION_COOKIE_SECURE=true


# ------------------------------------------------------------
# G. CORS / Frontend
# ------------------------------------------------------------

# Comma-separated list of allowed origins for CORS.
# Set to your production domain. Leave empty to block all cross-origin requests.
ALLOWED_ORIGINS=https://lab.cloudnetops.tech


# ------------------------------------------------------------
# H. Application Server
# ------------------------------------------------------------

APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json


# ------------------------------------------------------------
# I. Quota
# ------------------------------------------------------------

# Maximum VMs per student user (default 1).
MAX_VMS_PER_USER=1

# Maximum total VMs system-wide.
MAX_TOTAL_VMS=12


# ------------------------------------------------------------
# J. Optional Integrations (leave empty to disable)
# ------------------------------------------------------------

# Directus CMS URL. Leave empty to disable Directus auth.
# DIRECTUS_URL=http://127.0.0.1:8055

# DeepSeek AI tutor. Leave empty to disable.
# DEEPSEEK_API_KEY=<set-in-secret-manager>
# DEEPSEEK_MODEL=deepseek-chat


# ------------------------------------------------------------
# NOT INCLUDED — values that must NOT appear here:
# - Real API keys (LABGEN_LLM_OPENAI_API_KEY, ADMIN_TOKEN, etc.)
# - Real Proxmox credentials (PROXMOX_TOKEN_SECRET, VM_SSH_PASSWORD)
# - Real kubeconfig content
# - Real private keys or certificates
# All secrets must be injected via secret manager at runtime.
# ------------------------------------------------------------
