# ================================
# K8S NetLab Configuration
# ================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ----------------
# Proxmox VE Settings
# ----------------
# Proxmox VE 主机地址（IP 或 hostname）
PROXMOX_HOST=your-proxmox-ip
# Proxmox VE API 端口（默认 8006）
PROXMOX_PORT=8006
# Proxmox VE 节点名称
PROXMOX_NODE=pve
# 是否验证 SSL 证书（自签名证书设 false）
PROXMOX_VERIFY_SSL=false

# ----------------
# Proxmox 认证方式（二选一，Token 优先）
# ----------------
#
# 【推荐】方式一：API Token（最小权限）
#
#   在 PVE shell 执行以下命令创建专用用户和 Token：
#
#   # 1. 创建专用用户
#   pveum user add k8s-netlab@pve --comment "K8S NetLab Service Account"
#
#   # 2. 创建自定义角色（仅需的最小权限）
#   pveum role add K8SNetLab -privs \
#     "VM.Audit VM.PowerMgmt VM.Clone VM.Allocate \
#      VM.Config.Disk VM.Config.CPU VM.Config.Memory VM.Config.Network \
#      Datastore.AllocateSpace"
#
#   # 3. 将角色分配给用户
#   pveum acl modify / -user k8s-netlab@pve -role K8SNetLab
#
#   # 4. 生成 Token（secret 只显示一次，请立即保存）
#   pveum user token add k8s-netlab@pve netlab-token --privsep 0
#
PROXMOX_TOKEN_ID=k8s-netlab@pve!netlab-token
PROXMOX_TOKEN_SECRET=your-token-secret-here

# 【兼容】方式二：用户名 + 密码（仅用于开发/迁移期，不推荐生产）
# 若已填写 Token，下面两行可留空或删除
# PROXMOX_USER=root@pam
# PROXMOX_PASSWORD=your-proxmox-password

# ----------------
# VM 模板与规格
# ----------------
# 克隆源模板的 VMID（必须预先创建好 K3s 模板）
VM_TEMPLATE_ID=9000
# VM CPU 核数（教学优化：2核，单人/演示可用4核）
VM_CORES=2
# VM 内存（MB）（教学优化：4GB，单人/演示可用8192）
VM_MEMORY_MB=4096
# VM 会话超时时间（分钟）
VM_SESSION_TIMEOUT_MIN=30

# ----------------
# VM 网络配置（隔离网段）
# ----------------
VM_NETWORK=172.16.100.0/24
VM_GATEWAY=172.16.100.1
VM_BRIDGE=vmbr1
VM_IP_START=10
VM_IP_END=254

# ----------------
# VM SSH 连接配置
# ----------------
# VM SSH 用户名（与模板保持一致，推荐使用 root 避免 sudo 问题）
VM_SSH_USER=root
# VM SSH 密码（与模板保持一致）
VM_SSH_PASSWORD=your-vm-ssh-password

# ----------------
# 应用配置
# ----------------
# 后端监听地址
APP_HOST=0.0.0.0
# 后端监听端口
APP_PORT=8000
# 调试模式（生产环境设 false）
APP_DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ----------------
# CORS 配置
# ----------------
# 允许跨域请求的来源，逗号分隔。
# 留空（默认）= 拒绝所有跨域请求（推荐生产配置）。
# 多域名示例：ALLOWED_ORIGINS=https://lab.example.com,https://admin.example.com
# 本地开发：ALLOWED_ORIGINS=http://localhost:8000
ALLOWED_ORIGINS=

# ================================
# 部署提示
# ================================
#
# 必须修改（带 your-* 的项）:
#   PROXMOX_HOST         - Proxmox 服务器地址
#   PROXMOX_TOKEN_SECRET - Proxmox API Token secret（或 PROXMOX_PASSWORD）
#   VM_SSH_PASSWORD      - VM 模板的 SSH 密码
#
# 生产环境额外建议:
#   - APP_DEBUG=false
#   - PROXMOX_VERIFY_SSL=true（需要有效证书）
#   - 使用 Token 认证（PROXMOX_TOKEN_ID / PROXMOX_TOKEN_SECRET），避免 root 密码
#   - ALLOWED_ORIGINS 设为实际域名，禁止通配符
#   - 确保 .env 已加入 .gitignore
#
