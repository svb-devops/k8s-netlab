# Proxmox Configuration
PROXMOX_HOST=your-proxmox-ip
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your-password-here
PROXMOX_VERIFY_SSL=false
PROXMOX_NODE=pve

# VM SSH Credentials (for terminal access)
VM_SSH_USER=k8s_lab
VM_SSH_PASSWORD=your-vm-ssh-password

# VM Configuration
VM_TEMPLATE_ID=100
VM_CORES=4
VM_MEMORY_MB=8192
VM_SESSION_TIMEOUT_MIN=30

# Network Isolation Configuration
# VMs run on an isolated subnet, separated from the home network (10.0.0.0/24)
VM_NETWORK=172.16.100.0/24
VM_GATEWAY=172.16.100.1
VM_BRIDGE=vmbr1
VM_IP_START=10
VM_IP_END=254

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
LOG_LEVEL=INFO
