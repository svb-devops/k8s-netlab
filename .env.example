# ================================
# K8S NetLab Configuration
# ================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ----------------
# Proxmox VE Settings
# ----------------
# Proxmox VE 主机地址（IP 或 hostname）
PROXMOX_HOST=your-proxmox-ip
# Proxmox VE API 端口（默认 8006）
PROXMOX_PORT=8006
# Proxmox VE 节点名称
PROXMOX_NODE=pve
# Proxmox VE API 用户（需要 VM 创建/管理权限）
PROXMOX_USER=root@pam
# Proxmox VE API 密码
PROXMOX_PASSWORD=your-proxmox-password
# 是否验证 SSL 证书（自签名证书设 false）
PROXMOX_VERIFY_SSL=false

# ----------------
# VM 模板与规格
# ----------------
# 克隆源模板的 VMID（必须预先创建好 K3s 模板）
VM_TEMPLATE_ID=100
# VM CPU 核数
VM_CORES=4
# VM 内存（MB）
VM_MEMORY_MB=8192
# VM 会话超时时间（分钟）
VM_SESSION_TIMEOUT_MIN=30

# ----------------
# VM 网络配置（隔离网段）
# ----------------
VM_NETWORK=172.16.100.0/24
VM_GATEWAY=172.16.100.1
VM_BRIDGE=vmbr1
VM_IP_START=10
VM_IP_END=254

# ----------------
# VM SSH 连接配置
# ----------------
# VM SSH 用户名（与模板保持一致）
VM_SSH_USER=k8s_lab
# VM SSH 密码（与模板保持一致）
VM_SSH_PASSWORD=your-vm-ssh-password

# ----------------
# 应用配置
# ----------------
# 后端监听地址
APP_HOST=0.0.0.0
# 后端监听端口
APP_PORT=8000
# 调试模式（生产环境设 false）
APP_DEBUG=false
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ================================
# 部署提示
# ================================
#
# 必须修改（带 your-* 的项）:
#   PROXMOX_HOST      - Proxmox 服务器地址
#   PROXMOX_PASSWORD  - Proxmox 登录密码
#   VM_SSH_PASSWORD   - VM 模板的 SSH 密码
#
# 生产环境额外建议:
#   - APP_DEBUG=false
#   - PROXMOX_VERIFY_SSL=true（需要有效证书）
#   - 使用专用 Proxmox 用户，限制权限范围
#   - 确保 .env 已加入 .gitignore
#
